#!/usr/bin/env python3
# hermbot-send - say something to a bot, from anywhere.
#
#   hermbot-send --bot dev "status?"           # fire, answer arrives later
#   echo "long text" | hermbot-send --bot web  # stdin is safe for any text
#   hermbot-send --bot dev --wait "ping"       # stay in the foreground
#
# The delivery door is the one Hermes itself uses for bot-to-bot DMs
# (tools/bot_mode_dm.py): a resume of the bot's canonical "Bot Chat", created
# on demand, with the message handed over through --query-file so nothing is
# shell-interpreted. Delivering into that same forever-chat is the whole point -
# the desktop, the CLI and this widget then share one conversation per bot.
#
# Default is fire-and-forget: the turn runs detached, and the reply surfaces
# through hermbot-watch's notifications. --wait keeps it attached and prints
# the reply, for scripts and debugging.
import argparse
import json
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path

WATCH = Path(__file__).resolve().parent / "hermbot-watch"
_HERE = Path(__file__).resolve().parent if "__file__" in globals() else Path.cwd()
sys.path.insert(0, str(_HERE))
import hermbot_paths  # noqa: E402  (a sibling script directory, resolved above)

STATE = hermbot_paths.STATE_DIR
SEND_LOG = STATE / "send.log"
BOT_CHAT = "Bot Chat"


def log(line):
    # Timestamped like it always was; the shared helper only bounds the file.
    hermbot_paths.append_log(SEND_LOG, f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {line.rstrip()}")


def resolve(name):
    """The bot's profile name, validated against the live roster."""
    out = subprocess.run([str(WATCH), "--once"], capture_output=True, text=True, timeout=30)
    if out.returncode != 0 or not out.stdout.strip():
        detail = out.stderr.strip() or out.stdout.strip()
        raise RuntimeError(f"hermbot-watch failed: {detail[:200]}")
    snap = json.loads(out.stdout.splitlines()[-1])
    wanted = (name or "").lstrip("@").strip().lower()
    for bot in snap.get("bots", []):
        if bot["name"].lower() == wanted or (bot.get("title") or "").lower() == wanted:
            return bot
    raise RuntimeError(f"no bot named {name!r} in the roster")


def resolve_title(title, bot):
    """The id of a chat by its exact title, or '' - asked of the watcher, which owns
    the store access. A chat is created by its first message, so its id only exists
    after that message has been delivered."""
    try:
        out = subprocess.run([str(WATCH), "--find-title", str(title), "--bot", str(bot)],
                             capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return ""
    if out.returncode != 0 or not out.stdout.strip():
        return ""
    try:
        return str(json.loads(out.stdout.strip().splitlines()[-1]).get("session_id") or "")
    except (ValueError, AttributeError):
        return ""


def command_for(bot, query_file, session_id=None, stream=False, image=None, title=None):
    """The command that delivers the message.

    Default target is the bot's canonical "Bot Chat" - the forever-chat Hermes
    itself DMs a bot in, shared by the desktop, the CLI and this widget. With
    session_id the message goes into that exact thread instead, which is what a
    chat window opened from a session row has to do: the conversation the user
    picked is the conversation they type into, or the reply lands somewhere they
    are not looking. With title (and no session_id) the message CREATES a chat of
    that name - how the widget starts a fresh conversation of its own.
    """
    cmd = ["hermes"]
    if bot["name"] != "default":
        cmd += ["-p", bot["name"]]
    cmd += ["chat", "--in", str(Path.home())]
    if session_id:
        cmd += ["--resume", session_id]
    else:
        cmd += ["-c", str(title or BOT_CHAT), "--create-if-missing"]
    if image:
        cmd += ["--image", str(image)]
    cmd += ["-Q"]
    if stream:
        # Incremental text events, so a chat window can print the reply as it is
        # written instead of showing a spinner for the whole turn.
        cmd += ["--format", "stream-json"]
    cmd += ["--query-file", str(query_file)]
    return cmd


def query_dir():
    path = STATE / "sends"
    path.mkdir(parents=True, exist_ok=True)
    return path


def prune_query_files(max_age_s=86400):
    """Drop yesterday's message files - they hold user text and must not pile up."""
    cutoff = time.time() - max_age_s
    try:
        for old in query_dir().glob("send-*.txt"):
            if old.stat().st_mtime < cutoff:
                old.unlink()
    except OSError:
        pass


def write_query_file(text):
    """The message as a file hermes reads with --query-file.

    It must SURVIVE the spawn: the detached child reads it after we return, so
    an unlink here is a race (the turn dies with "cannot read --query-file").
    Kept under the state dir at 0600 and pruned by the next run instead.

    Written through the descriptor `mkstemp` handed back rather than by reopening
    the name: the second open could follow a link swapped in at that path between
    the two calls, and the message would land wherever it pointed.
    """
    handle, name = tempfile.mkstemp(prefix="send-", suffix=".txt", dir=str(query_dir()))
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as fh:
            fh.write(text)
    except BaseException:
        try:
            os.unlink(name)
        except OSError:
            pass
        raise
    return Path(name)


def main(argv=None):
    ap = argparse.ArgumentParser(description="Send a message into a bot's canonical Bot Chat.")
    ap.add_argument("--bot", required=True, help="bot name (Hermes profile) or @handle")
    ap.add_argument("--session", default=None,
                    help="deliver into this exact session id instead of the canonical Bot Chat")
    ap.add_argument("--text", default=None, help="message text (default: read stdin)")
    ap.add_argument("--wait", action="store_true", help="run in the foreground and print the reply")
    ap.add_argument("--stream", action="store_true",
                    help="foreground, emit the turn as stream-json lines (for a chat window)")
    ap.add_argument("--image", default=None,
                    help="a local image path to attach to this turn (the model sees it)")
    ap.add_argument("--title", default=None,
                    help="create a chat of this name when --session is not given")
    ap.add_argument("--print", dest="dry_run", action="store_true", help="print the command instead of running it")
    ap.add_argument("--json", action="store_true", help="machine-readable result")
    args = ap.parse_args(argv)

    text = args.text if args.text is not None else sys.stdin.read()
    if not text.strip():
        return _fail(args, "empty message")
    try:
        bot = resolve(args.bot)
    except (RuntimeError, json.JSONDecodeError) as exc:
        return _fail(args, str(exc))

    prune_query_files()
    query_file = write_query_file(text)
    cmd = command_for(bot, query_file, args.session, args.stream, args.image, args.title)
    result = {
        "bot": bot["name"],
        "session_id": args.session or bot["chat"]["session_id"],
        "created_chat": bool(not bot["chat"]["exists"] and not args.session),
        "command": " ".join(cmd),
        "text_chars": len(text),
        "image": args.image,
        "mode": "stream" if args.stream else ("wait" if args.wait else "detached"),
        "pid": None,
        "reply": None,
    }

    if args.dry_run:
        try:
            query_file.unlink()
        except OSError:
            pass
        result["mode"] = "dry-run"
        print(json.dumps(result, ensure_ascii=False) if (args.json or args.dry_run) else result["command"])
        return 0

    env = {**os.environ, "HERMBOT_SEND_FILE": str(query_file)}
    if args.stream:
        # Foreground with stdout INHERITED on purpose: the chat window parses the
        # stream-json lines as they arrive, so this process must not capture or
        # buffer them. The query file is unlinked only once the child is gone -
        # removing it earlier is the race that kills a turn mid-read.
        proc = subprocess.run(cmd, env=env, cwd=str(Path.home()))
        result["exit_code"] = proc.returncode
        try:
            query_file.unlink()
        except OSError:
            pass
        # A line of our own after the agent's stream: when this turn CREATED the
        # chat, the caller has no way to know its id otherwise, and without it the
        # window could never read back what it just wrote.
        if args.title and not args.session:
            created = resolve_title(args.title, bot["name"])
            if created:
                result["session_id"] = created
                result["created_chat"] = True
                print(json.dumps({"type": "hermbot", "session_id": created,
                                  "title": args.title}, ensure_ascii=False))
        log(f"{bot['name']}: stream finished rc={proc.returncode}")
        if args.json:
            print(json.dumps(result, ensure_ascii=False))
        return 0 if proc.returncode == 0 else 1
    if args.wait:
        proc = subprocess.run(cmd, capture_output=True, text=True, env=env, cwd=str(Path.home()))
        result["reply"] = (proc.stdout or "").strip()[-4000:]
        result["exit_code"] = proc.returncode
        if proc.returncode != 0:
            result["stderr"] = (proc.stderr or "").strip()[-1000:]
            log(f"{bot['name']}: wait failed rc={proc.returncode}")
    else:
        # Detached: the widget must return instantly, and the reply is announced
        # by hermbot-watch, not printed into a bar process that has exited.
        logf = STATE / "send.out"
        STATE.mkdir(parents=True, exist_ok=True)
        # The child needs a descriptor, not a line, so the shared append helper does
        # not fit here - but the same two rules do: bound the file before adding to
        # it (nothing ever prunes this one), and open it without following a link.
        try:
            if logf.stat().st_size > hermbot_paths.LOG_CAP_BYTES:
                hermbot_paths.atomic_write(
                    logf, logf.read_bytes()[-hermbot_paths.LOG_KEEP_BYTES:])
        except OSError:
            pass
        fd = hermbot_paths.open_nofollow(logf, os.O_WRONLY | os.O_CREAT | os.O_APPEND)
        with os.fdopen(fd, "a", encoding="utf-8") as fh:
            proc = subprocess.Popen(
                cmd, stdout=fh, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                start_new_session=True, env=env, cwd=str(Path.home()),
            )
        result["pid"] = proc.pid
        log(f"{bot['name']}: sent {len(text)} chars, pid={proc.pid}")

    if args.wait:
        # Only safe once the child has finished reading it.
        try:
            query_file.unlink()
        except OSError:
            pass
    else:
        result["query_file"] = str(query_file)

    if args.json:
        print(json.dumps(result, ensure_ascii=False))
    elif args.wait:
        print(result["reply"] or "")
    else:
        print(f"sent to {bot['handle']} (pid {result['pid']})")
    return 0 if result.get("exit_code", 0) == 0 else 1


def _fail(args, message):
    if args.json or args.dry_run:
        print(json.dumps({"error": message}, ensure_ascii=False))
    else:
        print(f"hermbot-send: {message}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
