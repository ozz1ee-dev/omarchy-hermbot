#!/usr/bin/env python3
# hermbot-watch - follow the local Hermes install and stream its Bot Mode
# roster as JSON lines.
#
#   stdout  {"generated_ts":..., "gateway":{...}, "counts":{...}, "bots":[...]}
#   args    --once            print one snapshot and exit
#           --interval N      seconds between polls (default 5)
#           --pretty          human-readable JSON instead of one line
#           --state PATH      state file for notification transitions (default
#                             ~/.local/state/omarchy/hermbot/notify.json)
#           --notify          emit omarchy notifications on state transitions
#           --hermes-root P   override ~/.hermes
#
# Everything read here is local and read-only: each profile's config
# (profile.yaml, gateway_state.json) and its session database opened with
# mode=ro. Nothing is written to a profile, nothing leaves the machine, and no
# network call is ever made - unlike Rakazo, the Hermes roster needs no token.
#
# A "bot" is a Hermes profile (Bot Mode's primitive). What the desktop shows in
# its Bots pane is what this emits: avatar metadata from profile.yaml's
# ui_meta['hermes-bots'], plus the one canonical chat that identifies the
# relationship - the session titled exactly "Bot Chat" (always born hidden).
# "Waiting on you" is the desktop's own watermark (last_activity_at past
# last_read_at) OR the widget's own record: the bot's newest turn is its own and
# is newer than the last time that bot was opened from the bar (seen.json,
# written by hermbot-open). The desktop never writes its watermark while you
# simply read, so without the second rule the roster sits still forever - and
# the avatars only animate on state changes. "Active now" mirrors the roster's
# activity filter (a write in the last 90s).
import argparse
import fcntl
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import time
import zlib
from pathlib import Path

_HERE = Path(__file__).resolve().parent if "__file__" in globals() else Path.cwd()
sys.path.insert(0, str(_HERE))
import hermbot_paths  # noqa: E402  (a sibling script directory, resolved above)

BOT_CHAT_TITLE = "Bot Chat"      # canonical chat title (tui_gateway contract)
ACTIVE_WINDOW_S = 90             # desktop roster: "wrote within the last 90s"
PREVIEW_CHARS = 160
HANDLE_DEFAULT = "hermes"        # @hermes is the default profile's alias (botHandle in the app)
# Every one of these can be somewhere else on somebody else's machine - see
# hermbot_paths.py for which environment variable each one follows.
DEFAULT_ROOT = hermbot_paths.ROOT
DEFAULT_STATE = hermbot_paths.STATE_DIR / "notify.json"
DEFAULT_SEEN = hermbot_paths.STATE_DIR / "seen.json"   # last opened, per bot
APPDATA = hermbot_paths.APPDATA   # Hermes Desktop's own state


# ── small helpers ───────────────────────────────────────────────────────────


def _read_yaml_flat(path):
    """Minimal YAML reader for the two files we care about.

    profile.yaml and gateway_state.json are machine-written and shallow, so we
    avoid a PyYAML dependency (the bar must run on a stock python3). Anything
    unparsable degrades to {} rather than raising.
    """
    try:
        text = Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return {}
    try:
        return json.loads(text)
    except ValueError:
        pass
    # Indentation-based parse, enough for nested maps of scalars.
    out = {}
    stack = [(-1, out)]
    for raw in text.splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip(" "))
        line = raw.strip()
        if ":" not in line:
            continue
        key, _, value = line.partition(":")
        key = key.strip().strip("'\"")
        value = value.strip()
        while stack and indent <= stack[-1][0]:
            stack.pop()
        parent = stack[-1][1] if stack else out
        if value == "":
            child = {}
            parent[key] = child
            stack.append((indent, child))
        else:
            parent[key] = _scalar(value)
    return out


def _scalar(value):
    value = value.strip()
    if value in ("true", "True"):
        return True
    if value in ("false", "False"):
        return False
    if value in ("null", "~", ""):
        return None
    if (value.startswith("'") and value.endswith("'")) or (
        value.startswith('"') and value.endswith('"')
    ):
        return value[1:-1]
    try:
        return int(value)
    except ValueError:
        pass
    try:
        return float(value)
    except ValueError:
        pass
    return value


def _hsl_to_hex(text):
    """'hsl(349 68% 58%)' → '#d1435b' so QML can paint it directly."""
    try:
        inside = text[text.index("(") + 1 : text.index(")")]
    except ValueError:
        return None
    parts = inside.replace(",", " ").replace("/", " ").split()
    nums = []
    for part in parts:
        part = part.strip().rstrip("%")
        try:
            nums.append(float(part))
        except ValueError:
            return None
    if len(nums) < 3:
        return None
    h, s, l = nums[0] % 360.0, min(max(nums[1] / 100.0, 0.0), 1.0), min(max(nums[2] / 100.0, 0.0), 1.0)
    c = (1 - abs(2 * l - 1)) * s
    x = c * (1 - abs((h / 60.0) % 2 - 1))
    m = l - c / 2
    table = [
        (c, x, 0), (x, c, 0), (0, c, x),
        (0, x, c), (x, 0, c), (c, 0, x),
    ][int(h // 60) % 6]
    r, g, b = (int(round((v + m) * 255)) for v in table)
    return "#%02x%02x%02x" % (r, g, b)


def color_hex(value):
    """Normalize any avatar color the desktop may store to '#rrggbb'."""
    if not isinstance(value, str) or not value.strip():
        return None
    text = value.strip()
    if text.startswith("#"):
        return text if len(text) in (4, 7) else None
    if text.lower().startswith("hsl"):
        return _hsl_to_hex(text)
    if text.lower().startswith("rgb"):
        try:
            nums = [int(round(float(n))) for n in text[text.index("(") + 1 : text.index(")")].replace(",", " ").split()]
        except (ValueError, IndexError):
            return None
        if len(nums) >= 3:
            return "#%02x%02x%02x" % tuple(max(0, min(255, n)) for n in nums[:3])
    return None


def _clean_preview(text):
    if not text:
        return ""
    text = " ".join(str(text).split())
    return text[:PREVIEW_CHARS] + ("…" if len(text) > PREVIEW_CHARS else "")


# ── profiles (bots) ─────────────────────────────────────────────────────────


def profiles_root(root):
    return root / "profiles"


MARKERS = ("config.yaml", ".env", "SOUL.md", "profile.yaml", "auth.json", "state.db")


def looks_like_install(path):
    """Is there a Hermes install here?

    The same marker rule the named profiles get. Without it a machine that has
    no Hermes at all - or a mistyped HERMES_HOME - answered with one phantom
    `default` bot instead of saying that there is nothing here.
    """
    try:
        if not path.is_dir():
            return False
        return any((path / marker).exists() or (path / marker).is_symlink() for marker in MARKERS)
    except OSError:
        return False


def bot_homes(root):
    """(name, home) for the default profile plus every live named profile.

    Mirrors the desktop: a profile counts only when its directory carries an
    identity marker, so infra dirs (sessions/, logs/) never appear as bots.
    """
    homes = [("default", root)] if looks_like_install(root) else []
    try:
        entries = sorted(p for p in profiles_root(root).iterdir() if p.is_dir())
    except OSError:
        entries = []
    for entry in entries:
        if entry.name.startswith("."):
            continue
        if any((entry / marker).exists() or (entry / marker).is_symlink() for marker in MARKERS):
            homes.append((entry.name, entry))
    return homes


def bot_meta(home_path, name):
    meta = _read_yaml_flat(home_path / "profile.yaml")
    ui = (meta.get("ui_meta") or {}).get("hermes-bots") or {}
    shape = ui.get("shape")
    return {
        "name": name,
        "handle": "@" + (HANDLE_DEFAULT if name == "default" else name),
        "title": ui.get("title") or name,
        "description": (meta.get("description") or "").strip() or None,
        "shape": shape,
        "color": color_hex(ui.get("color")),
        "image_kind": ui.get("imageKind") or "shape",
        "custom": bool(ui.get("custom")),
        "created": ui.get("created"),
        "bot_mode": bool(ui),
    }


def gateway_status(root):
    state = _read_yaml_flat(root / "gateway_state.json")
    pid = state.get("pid")
    alive = False
    if isinstance(pid, int) and pid > 0:
        try:
            os.kill(pid, 0)
            alive = True
        except OSError:
            alive = False
    return {
        "pid": pid,
        "running": alive and state.get("gateway_state") == "running",
        "state": state.get("gateway_state"),
        "profiles": state.get("served_profiles") or [],
        "active_agents": state.get("active_agents"),
        "updated_at": state.get("updated_at"),
    }


# ── session store ───────────────────────────────────────────────────────────


def open_store(home_path):
    db = home_path / "state.db"
    if not db.exists():
        return None
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=2.0)
        con.execute("PRAGMA query_only = 1")
        return con
    except sqlite3.Error:
        return None


def session_unread(last_activity, last_read):
    """Unread, exactly as the backend derives it (SessionDB.session_unread).

    ``last_read_at`` is a watermark: NULL = never tracked = READ, 0 = explicitly
    marked unread, otherwise unread when activity postdates the watermark.
    Getting this backwards paints every bot as "waiting on you" forever.
    """
    if last_read is None:
        return False
    return float(last_activity or 0) > float(last_read)


def newest_activity(con):
    """(ts, session_id, title) of the bot's freshest conversation.

    The desktop orders and pulses rows on the newest message in ANY of a bot's
    sessions (canonical chat, side chats, cron runs), not just the Bot Chat.
    """
    if con is None:
        return (0.0, None, None)
    try:
        row = con.execute(
            "SELECT last_activity_at, id, title FROM sessions WHERE archived = 0"
            " ORDER BY last_activity_at DESC LIMIT 1"
        ).fetchone()
    except sqlite3.Error:
        return (0.0, None, None)
    if not row:
        return (0.0, None, None)
    return (float(row[0] or 0), row[1], row[2])


def recent_visible_session(con):
    """The newest session a deep link can actually open.

    Canonical Bot Chats are always hidden, and the desktop's route validation
    refuses a session id that is not in its loaded (visible) list - so a link
    into a Bot Chat is dropped silently. The newest visible session IS
    openable, which is exactly what the roster's own right-click does.
    """
    if con is None:
        return None
    try:
        row = con.execute(
            "SELECT id, title, last_activity_at FROM sessions"
            " WHERE archived = 0 AND hidden = 0 ORDER BY last_activity_at DESC LIMIT 1"
        ).fetchone()
    except sqlite3.Error:
        return None
    if not row:
        return None
    return {"session_id": row[0], "title": row[1], "last_activity_at": float(row[2] or 0)}


A2A_RE = re.compile(r"^Message from (?:agent '([^']+)'|\U0001f916\s*([^\s(@]+))", re.I)


def preview_sender(preview):
    """Handle of the bot that sent a bot-to-bot DM, or None for a human thread.

    Mirrors the desktop's previewKind(): a preview carrying the delivery prefix
    is a DM, so the row should show who wrote rather than presenting it as the
    user's chat.
    """
    match = A2A_RE.match((preview or "").strip())
    if not match:
        return None
    name = (match.group(1) or match.group(2) or "").strip().lower()
    if not name or name == "default":
        return "@" + HANDLE_DEFAULT
    return "@" + name


def desktop_read_state(appdata=None):
    """Hermes Desktop's own record of what you have read, per profile.

    The desktop tracks read state in TWO places, and neither of them is the
    session store the widget reads. `sessions.last_read_at` (the backend
    watermark) is written only when a row is explicitly toggled - merely reading
    a chat never stamps it, so on a normal install it stays NULL for every
    session and reads as "read". The green dot you actually see is kept in the
    renderer instead:

        hermes.desktop.unreadFinishedSessions   profile -> [durable session ids]
        hermes.desktop.sessionSeenCounts        profile -> {id: message_count}

    The two mean different things and must not be merged: the first lists the
    chats that ARE unread, the second lists the ones you HAVE read (as the
    message count you saw), and a chat is unread when its count has since moved
    past that. Treating the second as another unread list would paint every chat
    you have ever opened as waiting on you.

    Both live in Electron's localStorage, i.e. a Chromium LevelDB under the app's
    own state directory. The keys are plain strings and the values are plain
    JSON, so the records are readable without a LevelDB client - the table files
    are scanned for the key and the object that follows it is decoded. A missing,
    locked or rewritten store yields {} rather than an error: this is a bonus
    signal, and the widget must keep working without it.

    Returns ({profile: {"marked": set(ids), "seen": {id: count}}}, available),
    where `available` says whether the desktop's store could be read at all. The
    caller needs that distinction: a store that exists is authoritative, and the
    widget's own watermark is only a stand-in for one that does not.
    """
    base = Path(appdata) if appdata else APPDATA
    out = {}
    found = False
    root = base / "Local Storage" / "leveldb"
    if not root.is_dir():
        return out, False
    try:
        files = sorted((p for p in root.iterdir() if p.is_file()),
                       key=lambda p: p.stat().st_mtime, reverse=True)
    except OSError:
        return out, False
    for path in files:
        try:
            raw = path.read_bytes()
        except OSError:
            continue
        if b"unreadFinishedSessions" in raw:
            for value in _json_values_after(raw, "unreadFinishedSessions"):
                found = True
                _merge_marked(out, value)
        if b"sessionSeenCounts" in raw:
            for value in _json_values_after(raw, "sessionSeenCounts"):
                found = True
                _merge_seen(out, value)
    return out, found


def _state_for(out, profile):
    bucket = out.get(profile)
    if bucket is None:
        bucket = out[profile] = {"marked": set(), "seen": {}}
    return bucket


def _merge_marked(out, value):
    """unreadFinishedSessions: {profile: [session id, ...]} - explicitly unread."""
    if not isinstance(value, dict):
        return
    for profile, ids in value.items():
        if not isinstance(profile, str):
            continue
        bucket = _state_for(out, profile)
        if isinstance(ids, list):
            bucket["marked"].update(i for i in ids if isinstance(i, str))
        elif isinstance(ids, dict):
            bucket["marked"].update(k for k in ids if isinstance(k, str))


def _merge_seen(out, value):
    """sessionSeenCounts: {profile: {session id: message_count}} - read, as seen."""
    if not isinstance(value, dict):
        return
    for profile, counts in value.items():
        if not isinstance(profile, str) or not isinstance(counts, dict):
            continue
        bucket = _state_for(out, profile)
        for sid, count in counts.items():
            if not isinstance(sid, str):
                continue
            try:
                n = int(count)
            except (TypeError, ValueError):
                bucket["seen"].setdefault(sid, 0)
                continue
            # A higher watermark never goes backwards for a given id.
            if n > bucket["seen"].get(sid, -1):
                bucket["seen"][sid] = n


def session_is_unread(state, profile, session_id, message_count):
    """Is one session unread by the desktop's own record?

    Explicitly marked wins; otherwise the chat is unread once its message count
    has moved past the count the desktop last acknowledged seeing.
    """
    bucket = (state or {}).get(profile)
    if not bucket or not session_id:
        return False
    if session_id in bucket["marked"]:
        return True
    baseline = bucket["seen"].get(session_id)
    if baseline is None:
        return False
    try:
        return int(message_count or 0) > int(baseline)
    except (TypeError, ValueError):
        return False


def _json_values_after(raw, key):
    """Decode every JSON object that directly follows `key` in a LevelDB file.

    A value can appear more than once (the current table, a compaction's log);
    callers merge them, and a newer record winning is not required - an id that
    appears in any record is one the desktop considers unread.
    """
    needle = key.encode()
    idx = 0
    while True:
        at = raw.find(needle, idx)
        if at < 0:
            return
        start = raw.find(b"{", at)
        if start < 0 or start - at > 400:
            idx = at + 1
            continue
        depth = 0
        for pos in range(start, len(raw)):
            char = raw[pos:pos + 1]
            if char == b"{":
                depth += 1
            elif char == b"}":
                depth -= 1
                if depth == 0:
                    try:
                        yield json.loads(raw[start:pos + 1].decode("utf-8", "replace"))
                    except ValueError:
                        pass
                    break
        idx = at + 1


def canonical_chat(con, profile_name):
    """The one chat that identifies a bot: the session titled exactly "Bot Chat".

    Same lookup the desktop performs (`session.list {title, include_hidden}`),
    read straight out of the store so the widget needs no running backend.
    """
    if con is None:
        return None
    try:
        row = con.execute(
            "SELECT id, title, last_activity_at, last_read_at, message_count,"
            " pinned, hidden, archived, ended_at"
            " FROM sessions WHERE title = ?"
            + (" AND profile_name = ?" if profile_name != "default" else "")
            + " ORDER BY last_activity_at DESC LIMIT 1",
            (BOT_CHAT_TITLE, profile_name) if profile_name != "default" else (BOT_CHAT_TITLE,),
        ).fetchone()
    except sqlite3.Error:
        try:
            row = con.execute(
                "SELECT id, title, last_activity_at, last_read_at, message_count,"
                " pinned, hidden, archived, ended_at FROM sessions WHERE title = ?"
                " ORDER BY last_activity_at DESC LIMIT 1",
                (BOT_CHAT_TITLE,),
            ).fetchone()
        except sqlite3.Error:
            return None
    if not row:
        return None
    (sid, _title, last_activity, last_read, count, pinned, hidden, archived, ended) = row
    preview, preview_role, preview_ts = latest_message(con, sid)
    last_activity = float(last_activity or 0)
    return {
        "session_id": sid,
        "exists": True,
        "hidden": bool(hidden),
        "pinned": bool(pinned),
        "archived": bool(archived),
        "ended": bool(ended),
        "message_count": int(count or 0),
        "last_activity_at": last_activity,
        "last_read_at": last_read,
        "unread": session_unread(last_activity, last_read),
        "preview": preview,
        "preview_role": preview_role,
        "preview_ts": preview_ts,
        "from_bot": preview_sender(preview),
    }


def latest_message(con, session_id):
    """(preview, role, ts) of the newest real turn in a session.

    Tool plumbing is skipped: only user/assistant text counts as something the
    roster should preview.
    """
    try:
        rows = con.execute(
            "SELECT role, content, timestamp FROM messages"
            " WHERE session_id = ? AND role IN ('user', 'assistant')"
            " AND content IS NOT NULL AND content != ''"
            " ORDER BY id DESC LIMIT 8",
            (session_id,),
        ).fetchall()
    except sqlite3.Error:
        return ("", None, None)
    for role, content, ts in rows:
        text = content
        if isinstance(text, str) and text.lstrip().startswith(("{", "[")):
            try:
                parsed = json.loads(text)
            except ValueError:
                parsed = None
            if isinstance(parsed, dict):
                text = parsed.get("text") or parsed.get("content") or ""
            elif isinstance(parsed, list):
                text = " ".join(
                    part.get("text", "")
                    for part in parsed
                    if isinstance(part, dict) and part.get("type") == "text"
                )
        cleaned = _clean_preview(text)
        if cleaned.strip():
            return (cleaned, role, ts)
    return ("", None, None)


def attach_session(con, read_state=None, profile=None):
    """The session to hang off a bot's row, and how it is labelled.

    Rule (the owner's): the session still open for this bot, or - when there is
    none - the last one that was finished. "Open" is `ended_at IS NULL`, the
    desktop's own line between a chat that is still going and one that is closed,
    and several can legitimately be open at once, so the newest by activity wins.
    Hidden rows are skipped: the row exists to be opened, and a canonical Bot Chat
    is not openable.

    Returns (row, mode) with mode in {"live", "closed", None}.
    """
    if con is None:
        return None, None
    base = (
        "SELECT id, title, last_activity_at, ended_at, message_count FROM sessions"
        " WHERE archived = 0 AND hidden = 0"
    )
    for mode, clause in (("live", " AND ended_at IS NULL"), ("closed", " AND ended_at IS NOT NULL")):
        try:
            row = con.execute(base + clause + " ORDER BY last_activity_at DESC LIMIT 1").fetchone()
        except sqlite3.Error:
            row = None
        if row:
            return session_row(con, row, read_state, profile), mode
    return None, None


def pinned_sessions(con, limit=12, read_state=None, profile=None):
    """This profile's pinned chats, newest first.

    Exactly the desktop's own Pinned section: `pinned = 1`, still visible, and
    deliberately excluded from the ordinary list so a chat never appears twice.
    """
    if con is None:
        return []
    try:
        rows = con.execute(
            "SELECT id, title, last_activity_at, ended_at, message_count FROM sessions"
            " WHERE pinned = 1 AND archived = 0 AND hidden = 0"
            " ORDER BY last_activity_at DESC LIMIT ?",
            (limit,),
        ).fetchall()
    except sqlite3.Error:
        return []
    return [session_row(con, row, read_state, profile) for row in rows]


def session_row(con, row, read_state=None, profile=None):
    """One session as the widget shows it.

    A title is not always usable - the desktop writes the literal string "None"
    for some chats - so fall back to the newest thing said there, exactly as the
    desktop's own sessionTitle() falls back to a preview.
    """
    sid, title, activity, ended_at, count = row
    label = "" if title is None else str(title).strip()
    if not label or label == "None":
        preview, _role, _ts = latest_message(con, sid) if con is not None else ("", None, None)
        label = preview or "untitled"
    return {
        "session_id": sid,
        "title": label,
        "last_activity_at": float(activity or 0),
        "ended": ended_at is not None,
        "message_count": count or 0,
        # The desktop's own verdict: this is the row the green dot hangs off.
        "unread": session_is_unread(read_state, profile, sid, count),
        "deep_link": f"hermes://open/{sid}",
    }


# ── which instance: follow the desktop's own choice ─────────────────────────
#
# Hermes Desktop can hold several sources (this machine, an SSH host, a remote
# gateway) and the roster has to be the roster of the one it is actually on. The
# app publishes its choice on disk, so there is nothing to configure here:
#
#   connections.json (v2 registry)  primary / launchMode / lastUsed
#   connection.json  (v1 routing)   mode / remote / profiles
#
# `primary` is what an apply writes back ("Apply must publish the same primary
# identity to connections.json"), and `launchMode: last-used` means the app
# reopens on `lastUsed` instead - so those two decide.
#
# An SSH source is read the way the app reads it: by running this very script on
# the other machine over ssh and streaming its JSON lines back. Nothing needs to
# be installed there, no token has to be minted, and the read stays read-only. A
# remote-gateway source (URL + token) speaks HTTP instead, with the token the
# app already stored for it.


def app_registry(appdata=None):
    """(registry, routing) as the desktop has them on disk, or (None, None)."""
    base = Path(appdata) if appdata else APPDATA
    def load(name):
        try:
            return json.loads((base / name).read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return None
    return load("connections.json"), load("connection.json")


def app_source(appdata=None):
    """The source Hermes Desktop is on: ("local", {}) or ("ssh", {...}).

    SSH is the only remote kind this can read without a token: the tunnel the app
    opens lives in its memory, but the host it points at is in the registry and
    our own ssh gets there directly.
    """
    registry, routing = app_registry(appdata)
    ids = {}
    if isinstance(registry, dict):
        for row in registry.get("connections") or []:
            if isinstance(row, dict) and row.get("id"):
                ids[str(row["id"])] = row
        # lastUsed is documented in the app's own registry as "the last source
        # the Sessions workspace successfully opened" - i.e. where the window is
        # now, whatever launchMode says. Measured: switching the window from
        # This device to an ssh host moved lastUsed and left primary alone, so
        # reading primary (or only trusting lastUsed under launchMode
        # 'last-used') left the bar on the wrong instance.
        primary = str(registry.get("primary") or "local")
        last_used = str(registry.get("lastUsed") or "")
        if last_used and last_used in ids:
            primary = last_used
    else:
        primary = "local"
    chosen = ids.get(primary)
    legacy = (routing or {}).get("mode")
    if chosen is None and legacy and legacy != "local":
        chosen = {"id": primary, "kind": legacy, **(routing.get("remote") or {})}
    if not chosen or chosen.get("kind") in (None, "local"):
        return "local", {}
    if chosen.get("kind") == "ssh":
        target = {
            "id": chosen.get("id") or "ssh",
            "label": chosen.get("label") or chosen.get("host") or "ssh",
            "host": chosen.get("host"),
            "user": chosen.get("user") or os.environ.get("USER") or "root",
            "port": chosen.get("port"),
            "key_path": chosen.get("keyPath"),
            "remote_hermes_path": chosen.get("remoteHermesPath"),
            "profile": chosen.get("remoteProfile"),
        }
        if not target["host"]:
            return "local", {}
        return "ssh", target
    # A gateway kind (URL + token) cannot be read yet - its stored token is
    # rotated by every gateway restart and the roster shapes would have to be
    # mapped. Say so instead of quietly showing this machine's bots as if they
    # were the ones the window is looking at.
    return "local", {
        "unsupported": str(chosen.get("id") or "gateway"),
        "unsupported_kind": str(chosen.get("kind") or "remote"),
        "label": str(chosen.get("label") or chosen.get("host") or chosen.get("id") or "gateway"),
    }


def ssh_argv(target, remote_args):
    """The ssh call that runs this script on the other machine.

    ControlMaster keeps one connection alive between polls, so the bar is not
    paying for a handshake every two seconds.
    """
    argv = ["ssh", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new",
            "-o", "ConnectTimeout=8", "-o", "ControlMaster=auto",
            "-o", f"ControlPersist=300", "-o", "LogLevel=ERROR"]
    if target.get("port"):
        argv += ["-p", str(target["port"])]
    if target.get("key_path"):
        argv += ["-i", str(target["key_path"])]
    argv += [f"{target.get('user') or 'root'}@{target['host']}", "python3 -", *remote_args]
    return argv


def apply_local_waiting(snap, seen, appdata=None, counts=None):
    """Re-apply the widget's own "wrote and you have not looked" rule.

    The remote side of a stream computes waiting from ITS state directory, which
    is empty by construction - the record of what you have looked at belongs to
    the machine you are sitting at, and it is the same record for every source.
    """
    if not isinstance(snap, dict) or not snap.get("bots"):
        return snap
    read_state, desktop_available = desktop_read_state(appdata)
    waiting = 0
    for bot in snap["bots"]:
        wrote = float(bot.get("wrote_at") or 0)
        seen_at = float(seen.get(bot.get("name")) or 0)
        unseen = bool(wrote and written_after(wrote, seen_at))
        chat = bot.get("chat") or {}
        chat_id = chat.get("session_id")
        chat_msgs = chat.get("message_count")
        # The desktop's green dot, which is per profile and therefore applies to
        # a bot on a remote instance too - it is the same profile name the app
        # keys its own record on.
        marked = session_is_unread(read_state, bot.get("name"), chat_id, chat_msgs)
        if marked:
            bot["desktop_unread"] = True
        # The desktop record exists only on the machine showing the bar, so the
        # fallback is decided here rather than on the remote.
        fallback = unseen and not desktop_available
        bot["waiting"] = bool(chat.get("exists") and (chat.get("unread") or marked or fallback))
        if bot["waiting"]:
            total = int(chat.get("message_count") or 0)
            baseline = (counts or {}).get(bot.get("name"))
            bot["unread_count"] = 1 if baseline is None else max(1, total - int(baseline))
        else:
            bot["unread_count"] = 0
        if bot["waiting"]:
            waiting += 1
    if isinstance(snap.get("counts"), dict):
        snap["counts"]["waiting"] = waiting
    return snap


def written_after(wrote, seen_at):
    return bool(seen_at) and wrote > seen_at


def snapshot(root, seen=None, appdata=None, counts=None):
    """One roster snapshot.

    `seen` maps bot name -> when that bot's chat was last opened from the bar;
    a bot whose own newest turn is newer than that stamp is waiting on you (see
    the header comment).
    """
    now = time.time()
    seen = seen or {}
    if not looks_like_install(root):
        # Nothing to show, and saying so beats a phantom bot: the widget turns
        # this into a short header and keeps the mark dimmed.
        return {"generated_ts": now, "error": "no Hermes install here",
                "error_detail": f"{root} does not look like a Hermes home",
                "gateway": gateway_status(root), "bots": [], "counts": {}}
    gw = gateway_status(root)
    served = set(gw["profiles"])
    # The desktop's own read record (localStorage), keyed by profile. This is the
    # green dot the user actually sees: the backend watermark is never stamped by
    # merely reading, so without this every row reads as read.
    read_state, desktop_available = desktop_read_state(appdata)
    bots = []
    for name, home_path in bot_homes(root):
        con = open_store(home_path)
        try:
            bot = bot_meta(home_path, name)
            chat = canonical_chat(con, name) if con else None
            newest_ts, newest_sid, _newest_title = newest_activity(con)
            recent = recent_visible_session(con)
            # The row under the bot's own: the session it is in, else the last
            # one it finished, plus that profile's pinned chats.
            attach, attach_mode = attach_session(con, read_state, name)
            pinned = pinned_sessions(con, read_state=read_state, profile=name)
            # What the bot itself said last: only its own turn is something to
            # come back to.
            if con is not None and chat and chat.get("session_id"):
                _preview, wrote_role, wrote_ts = latest_message(con, chat["session_id"])
            else:
                wrote_role, wrote_ts = None, None
        finally:
            if con is not None:
                con.close()
        if chat is None:
            chat = {
                "session_id": None, "exists": False, "hidden": True, "pinned": False,
                "archived": False, "ended": False, "message_count": 0,
                "last_activity_at": 0, "last_read_at": None, "unread": False,
                "preview": "", "preview_role": None, "preview_ts": None, "from_bot": None,
            }
        # "It wrote and you have not looked": its own newest turn, past the last
        # time this bot was opened from the bar. No record at all counts as
        # nothing new - a fresh install must not paint every bot as waiting.
        wrote_at = float(wrote_ts or 0) if wrote_role == "assistant" else 0.0
        seen_at = float(seen.get(name) or 0)
        unseen = bool(wrote_at and wrote_at > seen_at) if seen_at else False
        # The desktop's own verdict on this bot's chat, which the backend
        # watermark cannot give us: it is the same session id the desktop keys
        # its green dot on. `by_count` is the watermark half of that record, so a
        # chat whose message count has moved past what the desktop last
        # acknowledged is unread even when no explicit marker was written.
        chat_id = (chat or {}).get("session_id")
        desktop_says_unread = session_is_unread(read_state, name, chat_id,
                                                (chat or {}).get("message_count"))
        # The widget's own watermark is a stand-in only where the desktop keeps no
        # record at all. The desktop stamps its OWN watermark every time it shows a
        # session; ours is stamped only by a click on the bar - so trusting it next
        # to a live desktop record leaves a bot marked forever after the user reads
        # the chat in the app window instead.
        fallback_unseen = unseen and not desktop_available
        waiting = bool(chat["exists"] and (chat.get("unread")
                                           or desktop_says_unread or fallback_unseen))
        # The badge's number: messages in this bot's chat since the app last had it
        # read. `sync_counts()` keeps that baseline level with the desktop's own
        # verdict, so a chat read in the app window resets it too. With no baseline
        # yet we can still say something is waiting, just not how much - a bare 1
        # beats a fabricated count.
        unread_count = 0
        if waiting:
            total = int(chat.get("message_count") or 0)
            baseline = (counts or {}).get(name)
            unread_count = 1 if baseline is None else max(1, total - int(baseline))

        # Roster ordering/activity: newest of (bot created, newest message in any
        # of its sessions) - the desktop's own sortRosterBots().
        created_ms = bot.get("created") or 0
        activity = max(float(created_ms) / 1000.0, newest_ts or 0.0)
        bot.update(
            {
                "gateway_served": name in served,
                "chat": chat,
                "waiting": waiting,
                "unread_count": unread_count,
                # Machine-readable trail of that same rule.
                "wrote_at": wrote_at,
                "seen_at": seen_at,
                "desktop_unread": desktop_says_unread,
                "active": bool(newest_ts and (now - newest_ts) < ACTIVE_WINDOW_S),
                "activity_at": activity,
                "newest_session_id": newest_sid,
                "recent_session": recent,
                # What the panel hangs off this bot: one session (live, else the
                # last finished one) and every chat pinned in this profile.
                "attach": attach,
                "attach_mode": attach_mode,
                "pinned": pinned,
                "hermes_cmd": _hermes_cmd(name),
                "open": {
                    "session_id": chat["session_id"],
                    # Deep link into the canonical Bot Chat. The desktop's route
                    # validation drops a HIDDEN session id, so this link only
                    # works once the app grows a door for bot chats - the ladder
                    # in hermbot-open knows that and prefers recent_session.
                    "deep_link": (
                        f"hermes://open/{chat['session_id']}?profile={name}"
                        if chat["session_id"] else None
                    ),
                    # Name-addressed door to the same chat (desktop PR #115195):
                    # the app resolves the registry at open time, so the link is
                    # correct by construction and cannot dangle on a stale id.
                    "bot_link": f"hermes://bot/{name}",
                    "recent_deep_link": (
                        f"hermes://open/{recent['session_id']}?profile={name}"
                        if recent else None
                    ),
                },
            }
        )
        bots.append(bot)
    bots.sort(key=lambda b: (not b["active"], not b["waiting"], -(b["activity_at"] or 0)))
    return {
        "generated_ts": now,
        "source": "local",
        "hermes_root": str(root),
        "gateway": gw,
        "counts": {
            "bots": len(bots),
            "waiting": sum(1 for b in bots if b["waiting"]),
            "active": sum(1 for b in bots if b["active"]),
            "no_chat": sum(1 for b in bots if not b["chat"]["exists"]),
            "pinned": sum(len(b.get("pinned") or []) for b in bots),
        },
        "bots": bots,
    }


def _hermes_cmd(name):
    """The CLI door to this bot - the same agent the desktop opens."""
    return "hermes" + ("" if name == "default" else f" -p {name}") + " chat"


# ── notifications (state transitions only) ──────────────────────────────────


def load_state(path):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {"bots": {}}


def save_state(path, snap):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "updated_ts": snap["generated_ts"],
        "bots": {
            b["name"]: {
                "activity_at": b["activity_at"],
                "preview": b["chat"]["preview"],
                "preview_role": b["chat"]["preview_role"],
                "message_count": b["chat"]["message_count"],
                "unread": b["chat"]["unread"],
            }
            for b in snap["bots"]
        },
    }
    # A fixed temporary name beside the target is a symlink hazard wherever the
    # directory is not ours alone: the helper creates it exclusively and swaps it
    # in with a rename, so a pre-made entry can only be refused, never written
    # through.
    hermbot_paths.atomic_write(path, json.dumps(payload, ensure_ascii=False), encoding="utf-8")


# ── what you have already looked at ─────────────────────────────────────────
#
# The desktop writes no read watermark while you merely read, so "the bot wrote
# and you have not come back" has to be ours: hermbot-open stamps a bot here
# every time a click opens it, and the snapshot compares that stamp with the
# bot's own newest turn. Kept beside the notification state, in the same shape.


def _load_seen_payload(path):
    try:
        data = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def load_seen(path):
    bots = _load_seen_payload(path).get("bots")
    return bots if isinstance(bots, dict) else {}


def load_counts(path):
    """Per bot: the chat's message count as of the last time it read as read."""
    counts = _load_seen_payload(path).get("counts")
    return counts if isinstance(counts, dict) else {}


def save_seen(path, seen, counts=None):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    # A caller that only knows about the click record must not drop the other
    # half: two records, two writers, one file.
    if counts is None:
        counts = load_counts(path)
    payload = {"updated_ts": time.time(), "bots": seen, "counts": counts}
    hermbot_paths.atomic_write(path, json.dumps(payload, ensure_ascii=False, indent=2),
                               encoding="utf-8")


def mark_seen(path, name):
    """Record that this bot was just opened. Read-modify-write under the same
    lock the notifications use, so two concurrent clicks cannot lose a stamp."""
    handle = acquire_state_lock(path)
    try:
        seen = load_seen(path)
        seen[name] = time.time()
        save_seen(path, seen)
    finally:
        release_state_lock(handle)
    return seen.get(name)


def seed_seen(path, snap):
    """Give every bot we have no record for a baseline of "read up to now".

    Without it a fresh install would paint every bot as waiting on you (its last
    turn is newer than no stamp at all), and a bot nobody ever clicks would never
    be able to become waiting later either. Seeded at the bot's own last turn, so
    what it says *after* this counts as news.
    """
    handle = acquire_state_lock(path)
    try:
        seen = load_seen(path)
        changed = False
        for bot in snap.get("bots", []):
            if bot["name"] not in seen:
                seen[bot["name"]] = bot.get("wrote_at") or snap.get("generated_ts") or time.time()
                changed = True
        if changed:
            save_seen(path, seen)
        return seen
    finally:
        release_state_lock(handle)


def sync_counts(path, snap):
    """Keep the badge's baseline honest: seed it, then re-stamp it on every read.

    The badge counts "messages in this chat since it last read as read". Two things
    keep that number truthful:

    * a bot with no baseline gets one at first sight, so the count starts at one
      and grows with each new message rather than pinning at one forever;
    * a chat that is NOT waiting has been read, so its baseline is re-stamped at
      the current message count on every poll.

    The second is what survives a chat read in the app window, where this widget's
    own click record is never touched. The price of the first is that a bot which
    is *already* waiting when the widget first sees it shows "1" - its real backlog
    predates the only clock we have, and inventing that number would be a guess.
    """
    handle = acquire_state_lock(path)
    try:
        counts = load_counts(path)
        changed = False
        for bot in snap.get("bots", []):
            chat = bot.get("chat") or {}
            if not chat.get("session_id"):
                continue
            name = bot["name"]
            count = int(chat.get("message_count") or 0)
            # Seed an unknown bot; re-stamp one we just saw read. A waiting bot with
            # a baseline keeps it, so the number grows while you are not looking.
            if name not in counts or not bot.get("waiting"):
                if counts.get(name) != count:
                    counts[name] = count
                    changed = True
        if changed:
            # Both writers share one file, so write the other half back untouched.
            save_seen(path, load_seen(path), counts)
        return counts
    finally:
        release_state_lock(handle)


def transitions(prev, snap):
    """Bots that just wrote - one card per change, written by the bot.

    A card is only raised when the bot's canonical chat gained a message AND the
    newest message is the bot's own (or a bot-to-bot DM): being told about the
    message you just sent from the widget is noise. The first run seeds the
    world and announces nothing.
    """
    if not prev or not prev.get("bots"):
        return []
    events = []
    for bot in snap["bots"]:
        before = prev["bots"].get(bot["name"])
        if before is None:
            continue
        chat = bot["chat"]
        if not chat["exists"] or not chat["preview"]:
            continue
        if (chat["message_count"] or 0) <= (before.get("message_count") or 0):
            continue
        if chat["preview_role"] != "assistant" and not chat.get("from_bot"):
            continue
        if chat["preview"] == before.get("preview") and chat["preview_role"] == before.get("preview_role"):
            continue
        events.append(
            {
                "name": bot["name"],
                "title": bot["title"],
                "color": bot["color"],
                "preview": chat["preview"],
                "role": chat["preview_role"],
                "from_bot": chat.get("from_bot"),
                "waiting": bot["waiting"],
                "session_id": chat["session_id"],
            }
        )
    return events


def notification_sender():
    return shutil.which("omarchy-notification-send")


def opener_path():
    """The click target, as an absolute path (a bar process has no bin/ on PATH)."""
    return os.environ.get("HERMBOT_OPEN") or str(Path(__file__).resolve().parent / "hermbot-open")


def icon_arg():
    """The icon to stamp on a card: our own PNG when shipped, else an icon name.

    A bar widget is often instantiated twice, so the asset is located relative to
    this script (bin/../assets) rather than from the plugin's cwd.
    """
    asset = Path(__file__).resolve().parent.parent / "assets" / "hermbot.png"
    if asset.is_file():
        return str(asset)
    for candidate in ("hermbot", "hermes"):
        for root in ("/usr/share/icons", str(Path.home() / ".local/share/icons"), "/usr/share/omarchy"):
            try:
                if Path(root).exists() and next(Path(root).rglob(candidate + ".*"), None):
                    return candidate
            except OSError:
                continue
    return None


def notify_log(line):
    """One line per notification attempt. A debugging aid nobody rewrites, so the
    shared helper bounds it - see hermbot_paths.append_log."""
    hermbot_paths.append_log(Path(DEFAULT_STATE).parent / "notify.log",
                             f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {line.rstrip()}")


def replace_id(name):
    """A stable numeric id per bot.

    The sender rejects a non-numeric -r ("Invalid -r value"), so a per-bot int
    is how a chatty bot replaces its own previous card instead of stacking.
    """
    return 1000 + (zlib.crc32(name.encode("utf-8")) % 100000)


def notify(event):
    """One desktop notification per bot write: its own app name, a click that
    opens that bot, and a replace id so a chatty bot cannot stack twenty cards.

    Order matters: the sender consumes `<headline> [description]` BEFORE
    `--exec`, and everything after --exec belongs to the launched program.
    Failures are logged, never swallowed silently - a missing sender or a
    rejected flag must be visible, not "the widget just stopped notifying".
    """
    sender = notification_sender()
    if not sender:
        notify_log("no omarchy-notification-send on PATH - notifications disabled")
        return False
    cmd = [sender, "--app-name", "Hermbot", "-u", "normal",
           "-r", str(replace_id(event["name"]))]
    icon = icon_arg()
    if icon:
        cmd += ["-i", icon]
    cmd += [event["title"], event["preview"],
            "--exec", opener_path(), "--bot", event["name"], "--select"]
    try:
        out = subprocess.run(cmd, check=False, timeout=10, capture_output=True, text=True)
    except (OSError, subprocess.SubprocessError) as exc:
        notify_log(f"{event['name']}: sender failed: {exc}")
        return False
    if out.returncode != 0:
        notify_log(f"{event['name']}: sender rc={out.returncode} {out.stderr.strip()[:200]}")
        return False
    notify_log(f"{event['name']}: card sent ({event['preview'][:40]!r})")
    return True


# ── main ────────────────────────────────────────────────────────────────────


def acquire_state_lock(state_path, attempts=5, delay=0.1):
    """Serialize the notification state.

    A bar widget is frequently instantiated twice, so two watchers can poll the
    same install; without the lock both diff the same snapshot and post the same
    card twice. Returns the held handle, or None when another instance owns it.

    Opened without O_TRUNC and without following a symlink. `open("w")` - the
    obvious spelling - truncates, so a link planted at the lock's name, in a
    directory somebody else can write to, turns taking the lock into destroying
    whatever the link points at. The lock file's contents are never used, and the
    mode is checked on the descriptor rather than on the name.
    """
    lock_path = Path(str(state_path) + ".lock")
    try:
        lock_path.parent.mkdir(parents=True, exist_ok=True)
        fd = hermbot_paths.open_nofollow(lock_path, os.O_RDWR | os.O_CREAT)
        handle = os.fdopen(fd, "r+")
    except OSError:
        return None
    for _ in range(attempts):
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except OSError:
            time.sleep(delay)
    try:
        handle.close()
    except OSError:
        pass
    return None


def release_state_lock(handle):
    if handle is None:
        return
    try:
        fcntl.flock(handle, fcntl.LOCK_UN)
    except OSError:
        pass
    try:
        handle.close()
    except OSError:
        pass


def emit(snap, pretty):
    if pretty:
        print(json.dumps(snap, ensure_ascii=False, indent=2))
    else:
        print(json.dumps(snap, ensure_ascii=False), flush=True)


def settle(args, snap):
    """Announce transitions and record the world, under the shared lock."""
    handle = acquire_state_lock(args.state)
    try:
        if args.notify:
            prev = load_state(args.state)
            for event in transitions(prev, snap):
                # A notification backend failure must never take the watcher
                # (and with it the bar widget) down mid-poll.
                try:
                    notify(event)
                except Exception as exc:  # noqa: BLE001 - log and carry on
                    notify_log(f"{event.get('name')}: notify raised {type(exc).__name__}: {exc}")
        save_state(args.state, snap)
    finally:
        release_state_lock(handle)


def _source_label(target):
    """How to name a source in one word inside a message."""
    return str(target.get("label") or target.get("host") or target.get("id") or "remote")


def stamp(snap, kind, target):
    """Name the instance this snapshot came from, for the panel's own header."""
    label = "this device" if kind == "local" else (target.get("label") or target.get("host") or "remote")
    snap["source"] = "local" if kind == "local" else f"{kind}:{target.get('id') or target.get('host')}"
    snap["instance"] = label
    if target.get("unsupported"):
        # The window is somewhere we cannot read: be explicit rather than let the
        # local roster pass for it.
        snap["source_warning"] = f"{target['label']} ({target.get('unsupported_kind', 'remote')})"
    return snap


def source_of(args):
    """(kind, target) for this run. An explicit --source wins over the app's own
    choice, which is what a screenshot, a test or a fixed install wants."""
    want = (args.source or "auto").strip()
    if want == "auto":
        return app_source(args.appdata)
    if want == "local":
        return "local", {}
    if want.startswith("ssh:"):
        pick = want[4:].strip()
        registry, _ = app_registry(args.appdata)
        rows = [r for r in ((registry or {}).get("connections") or []) if isinstance(r, dict)]
        row = next((r for r in rows
                    if pick in (str(r.get("id") or ""), str(r.get("host") or ""), str(r.get("label") or ""))), None)
        row = row or {"id": pick, "host": pick}
        host = row.get("host") or pick
        return "ssh", {
            "id": row.get("id") or pick,
            "label": row.get("label") or host,
            "host": host,
            "user": row.get("user") or os.environ.get("USER") or "root",
            "port": row.get("port"),
            "key_path": row.get("keyPath"),
        }
    return "local", {}


def source_changed(args, kind, target):
    """Has the desktop switched connection since this run resolved one?

    Switching in the app rewrites connections.json - measured: it moves lastUsed
    and leaves primary alone - so re-reading that file is enough to notice. The
    check is cheap: re-read it and compare. Without this the widget would
    keep showing the roster of the machine you were on when it started.
    """
    if (args.source or "auto").strip() != "auto":
        return False
    now_kind, now_target = app_source(args.appdata)
    if now_kind != kind:
        return True
    if now_kind == "local":
        return False
    return (now_target.get("id"), now_target.get("host")) != (target.get("id"), target.get("host"))


def _remote_payload():
    """Everything the far side needs, as one script to feed to `python3 -`.

    The watcher imports its sibling module, so streaming the bare script is not
    enough any more. The payload unpacks the whole little bundle into a directory
    created for this connection and execs the watcher from there - which is also
    what makes `__file__` and the sibling import resolve.

    That directory is created, never taken from a guessable name. `/tmp` is
    world-writable, so a fixed `hermbot-watch-<uid>` path can be pre-created by
    another account on a shared host - as a directory it owns, or as a symlink
    aimed somewhere else entirely - and unpacking into it then writes through
    entries somebody else controls. So: prefer the session's own runtime directory
    (private to the account, and cleared when the session ends), fall back to a
    `mkdtemp` directory with a random name, verify that what we got is a real
    directory we own and force it to 0700, and keep the watcher's state files
    inside it as well instead of at fixed `/tmp` names. Only a directory that
    passed that check is ever pruned, and only of runs old enough to be nobody's
    live connection.
    """
    import base64
    import io
    import tarfile

    here = Path(__file__).resolve().parent
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
        for name in ("hermbot_paths.py", Path(__file__).name):
            tar.add(here / name, arcname=name)
    blob = base64.b64encode(buf.getvalue()).decode("ascii")
    return (
        "import base64, io, os, pathlib, shutil, stat, sys, tarfile, tempfile, time\n"
        f"blob = {blob!r}\n"
        "uid = os.getuid()\n"
        "def ours(path):\n"
        "    try:\n"
        "        os.mkdir(path, 0o700)\n"
        "    except FileExistsError:\n"
        "        pass\n"
        "    except OSError:\n"
        "        return None\n"
        "    try:\n"
        "        info = os.lstat(path)\n"
        "    except OSError:\n"
        "        return None\n"
        "    if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid:\n"
        "        return None\n"
        "    os.chmod(path, 0o700)\n"
        "    return path\n"
        "runtime = os.environ.get('XDG_RUNTIME_DIR') or ''\n"
        "candidates = [os.path.join(runtime, 'hermbot')] if runtime else []\n"
        "candidates.append(os.path.join(tempfile.gettempdir(), 'hermbot-%d' % uid))\n"
        "parent = None\n"
        "for cand in candidates:\n"
        "    if os.path.islink(cand):\n"
        "        continue\n"
        "    parent = ours(cand)\n"
        "    if parent:\n"
        "        break\n"
        "if parent:\n"
        "    for entry in os.scandir(parent):\n"
        "        try:\n"
        "            if time.time() - entry.stat(follow_symlinks=False).st_mtime < 3600:\n"
        "                continue\n"
        "            if entry.is_dir(follow_symlinks=False):\n"
        "                shutil.rmtree(entry.path, ignore_errors=True)\n"
        "            else:\n"
        "                os.unlink(entry.path)\n"
        "        except OSError:\n"
        "            pass\n"
        "    work = tempfile.mkdtemp(prefix='run-', dir=parent)\n"
        "else:\n"
        "    work = tempfile.mkdtemp(prefix='hermbot-watch-')\n"
        "with tarfile.open(fileobj=io.BytesIO(base64.b64decode(blob))) as tar:\n"
        "    try:\n"
        "        tar.extractall(work, filter='data')\n"
        "    except TypeError:\n"
        "        tar.extractall(work)\n"
        "w = pathlib.Path(work, 'hermbot-watch')\n"
        "w.chmod(0o700)\n"
        "os.execv(sys.executable, [sys.executable, str(w)] + sys.argv[1:] + [\n"
        "    '--state', os.path.join(work, 'notify.json'),\n"
        "    '--seen', os.path.join(work, 'seen.json'),\n"
        "])\n"
    )


def ssh_stream(args, target):
    """Stream the roster from another machine by running THIS script there.

    One ssh connection is held open (ControlMaster) and the remote copy runs in
    streaming mode; every line it prints is passed straight through, with the two
    decisions that can only be made on this side re-made here: what you have
    looked at, and whether a card should be raised. The remote copy keeps its state
    in its own private scratch directory, so it never writes into that machine's
    own widget state - and nothing of ours is addressed by a fixed path on a
    machine we do not own.
    """
    # The root is only worth passing when it was named explicitly: the other
    # machine's home is its own, and /home/<user>/.hermes does not exist there.
    remote_args = ["--interval", str(args.interval)]
    if str(args.hermes_root) != str(DEFAULT_ROOT):
        remote_args += ["--hermes-root", str(args.hermes_root)]
    script = _remote_payload()
    while True:
        try:
            proc = subprocess.Popen(ssh_argv(target, remote_args), stdin=subprocess.PIPE,
                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                    text=True, bufsize=1)
        except OSError as exc:
            emit(stamp({"generated_ts": time.time(), "error": f"{_source_label(target)} unreachable",
                        "error_detail": f"ssh failed: {exc}",
                        "bots": [], "counts": {}}, "ssh", target), args.pretty)
            if args.once:
                return 1
            time.sleep(max(args.interval, 2.0))
            continue
        try:
            proc.stdin.write(script)
            proc.stdin.close()
        except (OSError, ValueError):
            pass
        seen = load_seen(args.seen)
        while True:
            line = proc.stdout.readline()
            if not line:
                break
            line = line.strip()
            if not line:
                continue
            try:
                snap = json.loads(line)
            except ValueError:
                continue
            snap = apply_local_waiting(stamp(snap, "ssh", target), seen, args.appdata,
                                       load_counts(args.seen))
            settle(args, snap)
            if not args.once:
                sync_counts(args.seen, snap)
            emit(snap, args.pretty)
            if args.once:
                proc.terminate()
                return 0
            if source_changed(args, "ssh", target):
                notify_log(f"source ssh:{target.get('id')}: the desktop switched away")
                proc.terminate()
                return None
        detail = ""
        try:
            detail = (proc.stderr.read() or "").strip()
        except (OSError, ValueError):
            pass
        try:
            proc.wait(timeout=5)
        except subprocess.SubprocessError:
            proc.kill()
        # Close the pipes before the next reconnect. Dropping the reference alone
        # leaves the descriptors to the interpreter's GC, and a link that flaps
        # faster than it collects is how an ssh reconnector leaks file handles.
        for pipe in (proc.stdout, proc.stderr):
            try:
                if pipe is not None:
                    pipe.close()
            except OSError:
                pass
        notify_log(f"source ssh:{target.get('id')}: stream ended ({detail[:160]!r})")
        emit(stamp({"generated_ts": time.time(),
                    "error": f"{_source_label(target)} unreachable",
                    "error_detail": detail[:200] or "the other machine answered nothing",
                    "bots": [], "counts": {}}, "ssh", target), args.pretty)
        if args.once:
            return 1
        time.sleep(max(args.interval, 2.0))


def local_stream(args, kind, target):
    """Follow this machine's install, and stop when the desktop moves elsewhere."""
    root = Path(args.hermes_root).expanduser()
    while True:
        try:
            snap = stamp(snapshot(root, load_seen(args.seen), args.appdata,
                                  load_counts(args.seen)), kind, target)
        except Exception as exc:  # never take the bar down with us
            err = {"generated_ts": time.time(), "error": "this device unreadable",
                   "error_detail": f"{type(exc).__name__}: {exc}",
                   "bots": [], "counts": {}}
            emit(stamp(err, kind, target), args.pretty)
            if args.once:
                return 1
            time.sleep(max(args.interval, 1.0))
            continue
        settle(args, snap)
        if not args.once:
            # Only the streaming watcher seeds: --once is a read-only query used
            # by the opener, and it must not write state as a side effect.
            seed_seen(args.seen, snap)
            sync_counts(args.seen, snap)
        emit(snap, args.pretty)
        if args.once:
            return 0
        if source_changed(args, kind, target):
            notify_log("source local: the desktop switched away")
            return None
        time.sleep(max(args.interval, 1.0))


def main(argv=None):
    ap = argparse.ArgumentParser(description="Follow the local Hermes Bot Mode roster.")
    ap.add_argument("--once", action="store_true", help="print one snapshot and exit")
    ap.add_argument("--interval", type=float, default=5.0, help="seconds between polls")
    ap.add_argument("--pretty", action="store_true", help="pretty-print each snapshot")
    ap.add_argument("--state", default=str(DEFAULT_STATE), help="notification state file")
    ap.add_argument("--notify", action="store_true", help="send omarchy notifications on transitions")
    ap.add_argument("--seen", default=str(DEFAULT_SEEN), help="last-opened watermark per bot")
    ap.add_argument("--mark-seen", metavar="BOT",
                    help="record that this bot was just opened, then exit (used by hermbot-open)")
    ap.add_argument("--hermes-root", default=os.environ.get("HERMBOT_ROOT", str(DEFAULT_ROOT)))
    ap.add_argument("--source", default="auto",
                    help="auto = follow Hermes Desktop's own connection; local; or ssh:<id|host>")
    ap.add_argument("--appdata", default=None,
                    help="Hermes Desktop's state directory (default ~/.config/Hermes)")
    args = ap.parse_args(argv)

    if args.mark_seen:
        mark_seen(args.seen, args.mark_seen.lstrip("@").strip())
        return 0

    while True:
        kind, target = source_of(args)
        rc = ssh_stream(args, target) if kind == "ssh" else local_stream(args, kind, target)
        if rc is None:
            # The desktop switched connection: resolve again and follow it. A
            # short pause keeps a flapping registry from spinning.
            time.sleep(min(max(args.interval, 1.0), 3.0))
            continue
        return rc


if __name__ == "__main__":
    sys.exit(main())
